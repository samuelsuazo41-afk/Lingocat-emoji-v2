    { "id": "p2_4", "text": "{animal} dorm sota {objecte}", "dificultat": 2, "categories": ["animal", "objecte"], "nivell": 2, "roles": { "animal": ["animal"], "objecte": ["objecte"] }, "coherencia": "Dorm sota una cosa gran on hi cap un animal: arbre, pont. Mai sota un cactus o una rosa, que punxa i es petit.", "no_combina": { "objecte": ["cactus", "rosa", "tulipa", "bitxo", "campana", "micròfon"] } },
