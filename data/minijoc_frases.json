    { "id": "p2_8", "text": "{persona} guanya el partit de {esport} a {lloc}", "dificultat": 2, "categories": ["persona", "esport", "lloc"], "nivell": 2, "roles": { "persona": ["persona"], "esport": ["esport"], "lloc": ["lloc"] }, "coherencia": "Guanya un partit en un lloc on es juga. No guanya a la botiga.", "no_combina": { "lloc": ["botiga", "hospital", "banc"], "esport": ["pesca"] } },
