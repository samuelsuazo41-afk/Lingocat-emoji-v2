    { "id": "p2_6", "text": "{persona} està {emocio} amb {clima}", "dificultat": 2, "categories": ["persona", "emocio", "clima"], "nivell": 2, "roles": { "persona": ["persona"], "emocio": ["emocio"], "clima": ["clima"] }, "coherencia": "Esta content amb sol. Emocio i clima sense article.", "no_combina": {} },
