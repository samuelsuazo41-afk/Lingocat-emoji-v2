    { "id": "p3_3", "text": "{animal} corre per {natura} amb {clima}", "dificultat": 3, "categories": ["animal", "natura", "clima"], "nivell": 3, "roles": { "animal": ["animal"], "natura": ["natura"], "clima": ["clima"] }, "coherencia": "Corre per un lloc gran amb un clima. No corre per una rosa. No caça.", "no_combina": { "natura": ["rosa", "cactus", "tulipa"] } },
