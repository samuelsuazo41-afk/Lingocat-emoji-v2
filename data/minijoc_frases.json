    { "id": "p2_1", "text": "{persona} troba {objecte} a {lloc}", "dificultat": 2, "categories": ["persona", "objecte", "lloc"], "nivell": 2, "roles": { "persona": ["persona"], "objecte": ["objecte"], "lloc": ["lloc"] }, "coherencia": "Troba un objecte perdut en un lloc. Objecte petit i transportable.", "no_combina": { "objecte": ["edifici", "pont"], "lloc": ["kaaba"] } },
    { "id": "p2_2", "text": "{persona} va a {lloc} amb {transport}", "dificultat": 2, "categories": ["persona", "lloc", "transport"], "nivell": 2, "roles": { "persona": ["persona"], "lloc": ["lloc"], "transport": ["transport"] }, "coherencia": "Va a un lloc llunya amb un vehicle. No va amb el coet per anar a comprar pa.", "no_combina": { "transport": ["coet"] } },
