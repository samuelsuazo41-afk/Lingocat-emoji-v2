    { "id": "p3_1", "text": "{professio} ajuda a {persona} a {lloc}", "dificultat": 3, "categories": ["professio", "persona", "lloc"], "nivell": 3, "roles": { "professio": ["professio"], "persona": ["persona"], "lloc": ["lloc"] }, "coherencia": "Un professional ajuda en el seu lloc de feina: metge a l'hospital, professor a l'escola. No metge a la platja.", "no_combina": { "lloc": ["platja", "desert", "botiga"] } },
